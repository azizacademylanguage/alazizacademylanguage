# Django / Railway
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=YOUR-BACKEND.up.railway.app

# Railway PostgreSQL plugin odatda DATABASE_URL ni avtomatik beradi.
DATABASE_URL=postgresql://user:password@host:5432/database

# Netlify frontend URL — CORS va sertifikat QR linki uchun.
FRONTEND_PUBLIC_URL=https://YOUR-SITE.netlify.app
CORS_ALLOWED_ORIGINS=https://YOUR-SITE.netlify.app
CSRF_TRUSTED_ORIGINS=https://YOUR-SITE.netlify.app

# Birinchi production admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE-THIS-STRONG-PASSWORD
ADMIN_EMAIL=admin@example.com
# Faqat parolni env dagi qiymatga qayta o'rnatish kerak bo'lganda True qiling.
RESET_ADMIN_PASSWORD=False

# Railway Volume /app/media ga ulangan bo'lsa:
MEDIA_ROOT=/app/media
SERVE_MEDIA=True

# Ixtiyoriy AI baholash kaliti
ANTHROPIC_API_KEY=
# Ixtiyoriy: AI model nomi. Kalit bo'lmasa ichki tavsiya rejimi ishlaydi.
ANTHROPIC_MODEL=claude-sonnet-4-6
